# =============================================================================
# AssetVerify Property Services — Environment Variable Example
# =============================================================================
# Copy this file to `.env` (or set these in your hosting provider dashboard).
# NEVER commit the real `.env` file. NEVER put these values in frontend JS.
#
# Only variables prefixed with VITE_ / NEXT_PUBLIC_ are safe to expose if you
# add a build step. This project uses plain static HTML, so the *public* values
# are read at runtime from `assets/js/config.js` instead. Keep that file filled
# ONLY with the Supabase URL and the anon (public) key — never the service role.
# -----------------------------------------------------------------------------

# --- Supabase (PUBLIC — safe for the browser, protected by RLS) --------------
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# --- Supabase (PRIVATE — server-side only, used by Edge Functions) -----------
# The service role key bypasses RLS. NEVER expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Email provider (PRIVATE — server-side only) -----------------------------
# Example: Resend free tier. Swap for any provider with a free tier.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=YOUR_EMAIL_PROVIDER_API_KEY
EMAIL_FROM="AssetVerify Property Services <no-reply@example.com>"
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# --- Site configuration (PUBLIC — copied into config.js) --------------------
SITE_URL=https://your-username.github.io/assetverify
BUSINESS_NAME=AssetVerify Property Services
BUSINESS_EMAIL=info@example.com
BUSINESS_PHONE=+2340000000000
BUSINESS_ADDRESS=Port Harcourt, Rivers State, Nigeria

# --- Payment provider (PRIVATE — optional, server-side only) -----------------
# Leave blank to run in manual bank-transfer mode (default).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
